# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-to-something-strong
JENKINS_URL=http://localhost:8080/

# GitHub repo Jenkins will build, and a fine-grained PAT with read-only "Contents" access to it
APP_REPO_URL=https://github.com/<your-github-username>/jenkins-cicd-pipeline.git
GITHUB_USERNAME=<your-github-username>
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Any random string - generate with: openssl rand -hex 24
TEST_DEPLOY_TOKEN=replace-with-random-string
